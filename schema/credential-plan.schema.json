{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-credentials:credential-plan:schema:0.4.0",
  "title": "Credential Execution Plan",
  "contractVersion": "0.4.0",
  "description": "Provider-neutral, runtime-neutral credential execution plan of the Agent Credential Layer v0.4. A plan combines a v0.2 Diagnosis summary and a v0.3 Credential Context outcome into a deterministic gate (ready / blocked / needs_decision). It carries logical references only and never a raw credential value. Forbidden property names: token, password, secret, apiKey, credentialValue, authorizationHeader, rawCredential. No stdout/stderr/raw command output fields appear in this public contract.",
  "type": "object",
  "required": [
    "contractVersion",
    "provider",
    "operation",
    "diagnosis",
    "context",
    "gate",
    "decisionCode",
    "selectedCredentialReference",
    "executionMetadata"
  ],
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "enum": [
        "token",
        "password",
        "secret",
        "apiKey",
        "credentialValue",
        "authorizationHeader",
        "rawCredential"
      ]
    }
  },
  "properties": {
    "contractVersion": {
      "const": "0.4.0",
      "description": "Public contract version of the credential execution plan layer."
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "token",
            "password",
            "secret",
            "apiKey",
            "credentialValue",
            "authorizationHeader",
            "rawCredential"
          ]
        }
      },
      "description": "Safe summary of the v0.2 diagnosis result; it does not embed or redefine the full v0.2 Diagnosis Result schema.",
      "properties": {
        "status": {
          "enum": ["healthy", "degraded", "unavailable", "inconclusive"],
          "description": "v0.2 diagnosis status (healthy / degraded / unavailable / inconclusive)."
        },
        "code": {
          "type": ["string", "null"],
          "description": "Optional primary diagnosis failure code, when known."
        },
        "summary": {
          "type": ["string", "null"],
          "description": "Optional safe, non-secret diagnosis summary."
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "token",
            "password",
            "secret",
            "apiKey",
            "credentialValue",
            "authorizationHeader",
            "rawCredential"
          ]
        }
      },
      "description": "Safe summary of the v0.3 context resolver outcome; it does not embed or redefine the full v0.3 Credential Context schema.",
      "properties": {
        "outcome": {
          "enum": ["selected", "unavailable", "ambiguous", "conflict"],
          "description": "v0.3 context resolver outcome."
        },
        "selectedReference": {
          "anyOf": [
            { "$ref": "#/$defs/LogicalReference" },
            { "type": "null" }
          ],
          "description": "Selected logical reference, when the context resolved one; null otherwise."
        }
      }
    },
    "gate": {
      "enum": ["ready", "blocked", "needs_decision"],
      "description": "Deterministic broker gate state."
    },
    "decisionCode": {
      "type": ["string", "null"],
      "description": "Provider-neutral decision/reason code. When present it must be a v0.2 public resolution/decision code (checked by the validator)."
    },
    "selectedCredentialReference": {
      "anyOf": [
        { "$ref": "#/$defs/LogicalReference" },
        { "type": "null" }
      ],
      "description": "The selected logical credential reference for execution, or null when none is selected."
    },
    "executionMetadata": {
      "type": "object",
      "required": ["runtime", "host"],
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "token",
            "password",
            "secret",
            "apiKey",
            "credentialValue",
            "authorizationHeader",
            "rawCredential"
          ]
        }
      },
      "description": "Safe, non-secret execution metadata for the operator/caller; no raw credential material.",
      "properties": {
        "runtime": {
          "enum": ["host", "sandbox", "container", "remote", "ci", "unknown"],
          "description": "Kind of execution context."
        },
        "host": {
          "type": ["string", "null"],
          "description": "Target host, when known."
        },
        "note": {
          "type": ["string", "null"],
          "description": "Optional safe, non-secret note."
        }
      }
    }
  },
  "$defs": {
    "LogicalReference": {
      "type": "object",
      "required": ["provider", "sourceType", "reference"],
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "token",
            "password",
            "secret",
            "apiKey",
            "credentialValue",
            "authorizationHeader",
            "rawCredential"
          ]
        }
      },
      "description": "A logical, safe reference to a credential. Never a raw value.",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "sourceType": {
          "enum": ["env", "file", "keyring", "connector", "cli", "broker", "profile", "config", "other"]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:/+-]+$"
        },
        "account": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "host": { "type": ["string", "null"] }
      }
    }
  }
}
